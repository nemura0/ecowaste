---
// Ficha de cada punto: /puntos/<id>/. Se genera una página por cada archivo de src/data/puntos/.
// Muestra estado, residuos, fuente, fecha y delegación que verificó (issue #11). Funciona sin JavaScript.
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import {
  TIPOS,
  ESTADOS,
  RESIDUOS,
  TIPOS_DE_FUENTE,
  DELEGACIONES,
  fechaComoTexto,
  formatearFechaLegible,
  EXPLICACION_DE_ESTADO,
} from '../../lib/datos.mjs';
import Dibujo from '../../components/Dibujo.astro';

export async function getStaticPaths() {
  const puntos = await getCollection('puntos');
  return puntos.map((punto) => ({ params: { id: punto.id }, props: { punto } }));
}

interface Props {
  punto: CollectionEntry<'puntos'>;
}

const { punto } = Astro.props;
const { nombre, tipo, estado, ubicacion, residuos, horario, administrador, fuente, verificacion, ejemplo } = punto.data;

const tipoTexto = TIPOS[tipo] || tipo;
const lat = ubicacion.lat.toFixed(5);
const lng = ubicacion.lng.toFixed(5);
const enlaceOsm = `https://www.openstreetmap.org/?mlat=${lat}&mlon=${lng}#map=18/${lat}/${lng}`;
---

<Base
  titulo={nombre}
  titular={nombre}
  descripcion={`${tipoTexto} en ${ubicacion.comuna}: dónde está, qué recibe y de dónde sale el dato.`}
>
  <p class="volver"><a href="/">Volver al mapa</a></p>

  <div class="presentacion">
    <p class="tipo">
      {tipoTexto}
      {ejemplo && <span class="etiqueta-ejemplo">EJEMPLO</span>}
    </p>
    {tipo === 'contenedor' && <Dibujo nombre="contenedor" tamano={88} class="dibujo-tipo" />}
  </div>

  <div class={`panel-estado estado-${estado}`}>
    <p>
      <strong>{ESTADOS[estado] || estado}.</strong>{' '}
      {EXPLICACION_DE_ESTADO[estado]}
    </p>
    <a class="boton-mapa" href={enlaceOsm}>Ver el lugar en OpenStreetMap</a>
  </div>

  <section aria-labelledby="titulo-residuos">
    <h2 id="titulo-residuos">Qué recibe</h2>
    <ul class="residuos" role="list">
      {
        residuos.map((residuo) => (
          <li>
            <a href={`/que-reciclar/#${residuo}`}>
              <Dibujo nombre={residuo} tamano={40} />
              {RESIDUOS[residuo] || residuo}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="titulo-donde">
    <h2 id="titulo-donde">Dónde y cuándo</h2>
    <dl class="datos">
      <div>
        <dt>Dónde</dt>
        <dd>{ubicacion.descripcion}</dd>
      </div>
      <div>
        <dt>Comuna</dt>
        <dd>{ubicacion.comuna}</dd>
      </div>
      <div>
        <dt>Horario</dt>
        <dd>{horario ?? <span class="pendiente">[PENDIENTE] Falta confirmar el horario.</span>}</dd>
      </div>
      <div>
        <dt>Lo administra</dt>
        <dd>{administrador ?? <span class="pendiente">[PENDIENTE] Falta confirmar quién lo administra.</span>}</dd>
      </div>
      <div>
        <dt>Coordenadas</dt>
        <dd>{lat}, {lng}</dd>
      </div>
    </dl>
  </section>

  <section class="origen" aria-labelledby="titulo-origen">
    <h2 id="titulo-origen">¿Cómo sabemos esto?</h2>
    <dl class="datos">
      <div>
        <dt>Fuente</dt>
        <dd>
          {TIPOS_DE_FUENTE[fuente.tipo] || fuente.tipo}. {fuente.detalle}
          {
            fuente.enlace && (
              <>
                {' '}
                <a href={fuente.enlace} target="_blank" rel="noopener">
                  Ver fuente
                </a>
              </>
            )
          }
        </dd>
      </div>
      <div>
        <dt>Verificado por</dt>
        <dd>{DELEGACIONES[verificacion.delegacion] || verificacion.delegacion}</dd>
      </div>
      <div>
        <dt>Fecha de verificación</dt>
        <dd>
          <time datetime={fechaComoTexto(verificacion.fecha)}>{formatearFechaLegible(verificacion.fecha)}</time>
        </dd>
      </div>
    </dl>
  </section>
</Base>

<style>
  .volver {
    margin: 0 0 var(--espacio-2);
    font-size: var(--texto-chico);
  }

  /* Relleno vertical para que el enlace se pueda tocar con el dedo */
  .volver a {
    display: inline-block;
    padding-block: var(--espacio-2);
  }

  .presentacion {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--espacio-3);
  }

  .tipo {
    display: flex;
    align-items: center;
    gap: var(--espacio-3);
    margin: 0;
    color: var(--color-tinta-suave);
  }

  .presentacion :global(.dibujo-tipo) {
    flex: none;
    margin-top: calc(var(--espacio-6) * -1);
  }

  .panel-estado {
    margin-top: var(--espacio-4);
    padding: var(--espacio-4);
    border-radius: var(--radio-panel);
  }

  .panel-estado.estado-propuesto {
    background: var(--color-propuesto-fondo);
  }

  .panel-estado.estado-activo {
    background: var(--color-activo-fondo);
  }

  .panel-estado.estado-inactivo {
    background: var(--color-inactivo-fondo);
  }

  .panel-estado p {
    margin: 0 0 var(--espacio-4);
  }

  .boton-mapa {
    display: inline-block;
    padding: var(--espacio-3) var(--espacio-4);
    border-radius: var(--radio-pildora);
    background: var(--color-tinta);
    color: var(--color-fondo);
    font-size: var(--texto-chico);
    font-weight: var(--peso-fuerte);
    text-decoration: none;
  }

  .boton-mapa:hover {
    background: var(--color-verde-oscuro);
    color: var(--color-fondo);
  }

  h2 {
    margin: var(--espacio-7) 0 var(--espacio-3);
  }

  .residuos {
    display: flex;
    flex-direction: column;
    gap: var(--espacio-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .residuos a {
    display: flex;
    align-items: center;
    gap: var(--espacio-3);
    color: var(--color-tinta);
    text-decoration-color: var(--color-punto);
  }

  .residuos a:hover {
    text-decoration-color: var(--color-lapiz);
  }

  .datos {
    margin: 0;
  }

  .datos div {
    display: grid;
    grid-template-columns: var(--ancho-etiqueta-dato) 1fr;
    gap: var(--espacio-3);
    padding-block: var(--espacio-3);
    border-top: var(--borde-suave);
  }

  .datos dt {
    color: var(--color-tinta-suave);
  }

  .datos dd {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .datos .pendiente {
    display: block;
    font-size: var(--texto-chico);
  }

  .origen {
    margin-top: var(--espacio-7);
    padding: var(--espacio-5) var(--espacio-4) var(--espacio-3);
    border-radius: var(--radio-panel);
    background: var(--color-agua);
  }

  .origen h2 {
    margin-top: 0;
  }

  /* En el recuadro de la fuente, cada dato va bajo su nombre: los textos son largos */
  .origen .datos div {
    grid-template-columns: 1fr;
    gap: var(--espacio-1);
    border-top-color: var(--color-punto);
  }
</style>
