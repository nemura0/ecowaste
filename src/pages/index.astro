---
import Base from '../layouts/Base.astro';
import Mapa from '../components/Mapa.astro';
import ListaPuntos from '../components/ListaPuntos.astro';
import Metricas from '../components/Metricas.astro';
import SelectorResiduos from '../components/SelectorResiduos.astro';
import Dibujo from '../components/Dibujo.astro';
import { getCollection } from 'astro:content';
import campus from '../data/campus.json';

// El mismo orden en el mapa y en la lista, para que coincidan las letras A, B, C…
const puntos = (await getCollection('puntos')).sort((a, b) => a.data.nombre.localeCompare(b.data.nombre, 'es'));
---

<Base titulo="Mapa de reciclaje" titular="¿Qué tienes para reciclar?">
  <p class="bajada">Elige uno y te mostramos dónde dejarlo.</p>

  <SelectorResiduos />

  <Mapa campus={campus} puntos={puntos} />

  <p class="introduccion">
    Encuentra puntos de reciclaje de residuos electrónicos en Coquimbo. Partimos por el Campus Guayacán de la
    Universidad Católica del Norte.
  </p>

  <section class="nota-contenedor" aria-labelledby="titulo-contenedor">
    <Dibujo nombre="contenedor" tamano={64} />
    <div>
      <h2 id="titulo-contenedor">Contenedor del proyecto</h2>
      <p><strong>Propuesto.</strong> Todavía no existe.</p>
      <p class="pendiente">[PENDIENTE] Falta definir dónde va a estar, qué residuos va a recibir y su autorización.</p>
    </div>
  </section>

  <!-- Oculta mientras src/data/metricas.json esté vacío. -->
  <Metricas />

  <ListaPuntos puntos={puntos} />
</Base>

<script src="../scripts/portada.ts"></script>

<style>
  .bajada {
    margin: 0;
    color: var(--color-tinta-suave);
    font-size: var(--texto-destacado);
    letter-spacing: var(--espaciado-seccion);
  }

  .introduccion {
    margin: var(--espacio-5) 0;
    color: var(--color-tinta-suave);
  }

  .nota-contenedor {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--espacio-3);
    align-items: start;
    padding: var(--espacio-4);
    border-radius: var(--radio-panel);
    background: var(--color-propuesto-fondo);
  }

  .nota-contenedor h2 {
    margin: var(--espacio-1) 0 var(--espacio-2);
    font-size: var(--texto-destacado);
  }

  .nota-contenedor p {
    margin: 0;
  }

  .nota-contenedor .pendiente {
    margin-top: var(--espacio-3);
    font-size: var(--texto-chico);
  }
</style>
