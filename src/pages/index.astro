---
import Base from '../layouts/Base.astro';
import Mapa from '../components/Mapa.astro';
import ListaPuntos from '../components/ListaPuntos.astro';
import Metricas from '../components/Metricas.astro';
import { getCollection } from 'astro:content';
import campus from '../data/campus.json';

const puntos = await getCollection('puntos');
---

<Base titulo="Mapa de reciclaje" titular="Dónde dejar tus residuos electrónicos">
  <div class="introduccion">
    <p>
      Encuentra puntos de reciclaje de residuos electrónicos en Coquimbo. Partimos por el Campus Guayacán de la
      Universidad Católica del Norte.
    </p>
    <p>Busca los puntos en el mapa o en la lista de abajo. La lista dice qué recibe cada uno.</p>
  </div>

  <Mapa campus={campus} puntos={puntos} />

  <section class="estado-contenedor" aria-labelledby="titulo-contenedor">
    <div class="contenedor-caja">
      <div class="contenedor-texto">
        <h2 id="titulo-contenedor">Contenedor del proyecto</h2>
        <p>El contenedor del proyecto todavía no existe.</p>
        <p class="pendiente">
          [PENDIENTE] Falta definir dónde va a estar, qué residuos va a recibir y su autorización.
        </p>
      </div>
      <span class="etiqueta estado-propuesto">Propuesto</span>
    </div>
  </section>

  <!-- Oculta mientras src/data/metricas.json esté vacío. -->
  <Metricas />

  <ListaPuntos puntos={puntos} />
</Base>

<style>
  .introduccion {
    margin-top: var(--espacio-5);
    margin-bottom: var(--espacio-4);
  }

  .introduccion p {
    margin: 0 0 var(--espacio-2);
    line-height: var(--interlineado);
  }

  .estado-contenedor {
    margin-block: var(--espacio-5);
  }

  .contenedor-caja {
    background: var(--color-superficie);
    border: var(--borde);
    border-radius: var(--radio);
    padding: var(--espacio-4);
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--espacio-3);
    flex-wrap: wrap;
  }

  .contenedor-texto h2 {
    margin: 0 0 var(--espacio-1);
    font-size: var(--texto-base);
    line-height: var(--interlineado-titulo);
  }

  .contenedor-texto p {
    margin: 0;
    font-size: var(--texto-chico);
    color: var(--color-tinta-suave);
    line-height: var(--interlineado);
  }

  /* El recuadro punteado sale de global.css. Aquí va blanco, porque la caja ya es verde claro. */
  .contenedor-texto .pendiente {
    margin-top: var(--espacio-2);
    background: var(--color-fondo);
  }
</style>
