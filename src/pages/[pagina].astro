---
// Publica cada archivo de src/content/paginas/ como una página: que-reciclar.md queda en /que-reciclar/.
// Para agregar una página de texto basta con crear el archivo .md; no hace falta tocar este archivo,
// salvo que la página lleve bloques propios, como los residuos de "Qué reciclar" (ver abajo).
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import CategoriasResiduos from '../components/CategoriasResiduos.astro';

export async function getStaticPaths() {
  const paginas = await getCollection('paginas');
  return paginas.map((pagina) => ({ params: { pagina: pagina.id }, props: { pagina } }));
}

const { pagina } = Astro.props;
const { titulo, titular, descripcion } = pagina.data;
const { Content } = await render(pagina);
---

<Base titulo={titulo} titular={titular} descripcion={descripcion}>
  {pagina.id === 'que-reciclar' && <CategoriasResiduos />}
  <div class="prosa">
    <Content />
  </div>
</Base>
