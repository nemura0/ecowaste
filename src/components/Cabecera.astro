---
// Cabecera en papel punteado con el nombre del sitio y el menú. Debajo, el título de la página.
interface Props {
  titular: string;
}

const { titular } = Astro.props;

// Para sumar una página al menú, agrégala aquí. La ruta termina en "/".
const secciones = [
  { texto: 'Mapa', ruta: '/' },
  { texto: 'Qué reciclar', ruta: '/que-reciclar/' },
  { texto: 'Acerca', ruta: '/acerca/' },
];

const actual = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
---

<header class="cabecera punteado">
  <div class="contenedor fila">
    <a class="marca" href="/">
      <span class="marca-nombre">EcoWaste</span>
      <span class="marca-lugar a-mano" aria-hidden="true">Coquimbo</span>
    </a>
    <nav aria-label="Secciones del sitio">
      <ul>
        {
          secciones.map(({ texto, ruta }) => (
            <li>
              <a href={ruta} aria-current={ruta === actual ? 'page' : undefined}>
                {texto}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
<div class="contenedor titular">
  <h1>{titular}</h1>
</div>

<style>
  .cabecera {
    padding-block: var(--espacio-4) var(--espacio-5);
  }

  .fila {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--espacio-3) var(--espacio-4);
  }

  .marca {
    display: inline-flex;
    flex-direction: column;
    color: var(--color-tinta);
    text-decoration: none;
  }

  .marca-nombre {
    font-size: var(--texto-destacado);
    font-weight: var(--peso-fuerte);
    letter-spacing: var(--espaciado-titulo);
    line-height: 1;
  }

  .marca-lugar {
    margin-top: calc(var(--espacio-1) * -0.5);
    margin-left: var(--espacio-4);
    transform: rotate(-4deg);
    transform-origin: left;
  }

  .marca:hover .marca-nombre {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--espacio-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: inline-block;
    padding-block: var(--espacio-2);
    color: var(--color-tinta);
    font-size: var(--texto-chico);
    text-decoration: none;
    border-bottom: var(--grosor-subrayado) solid transparent;
  }

  nav a:hover {
    border-bottom-color: var(--color-tinta-suave);
  }

  /* La página en la que estás: subrayado a lápiz, además del aviso para lectores de pantalla */
  nav a[aria-current='page'] {
    border-bottom-color: var(--color-lapiz);
  }

  .titular h1 {
    margin: var(--espacio-6) 0 var(--espacio-4);
    font-size: var(--texto-titulo);
    letter-spacing: var(--espaciado-titulo);
    line-height: var(--interlineado-titulo);
    max-width: 18ch;
  }
</style>
