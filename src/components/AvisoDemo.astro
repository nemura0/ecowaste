---
// Aviso de demostración. Aparece en todas las páginas mientras src/data/sitio.json diga "modo": "demo".
// Si el modo no es "demo" ni "real", la compilación se detiene en vez de esconder el aviso.
import sitio from '../data/sitio.json';
import { validarModo } from '../lib/datos.mjs';

const esDemo = validarModo(sitio.modo) === 'demo';
---

{
  esDemo && (
    <aside class="aviso-demo" aria-label="Aviso de demostración">
      <p class="contenedor">
        <strong>Esto es una demo.</strong> Los puntos marcados EJEMPLO son inventados: no vayas a dejar nada en ellos.
      </p>
    </aside>
  )
}

<style>
  .aviso-demo {
    background: var(--color-mantequilla);
    color: var(--color-aviso-texto);
    font-size: var(--texto-chico);
  }

  .aviso-demo p {
    margin: 0;
    padding-block: var(--espacio-2);
  }
</style>
