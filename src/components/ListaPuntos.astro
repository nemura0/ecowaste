---
import {
  TIPOS,
  ESTADOS,
  RESIDUOS,
  TIPOS_DE_FUENTE,
  DELEGACIONES,
  fechaComoTexto,
} from '../lib/datos.mjs';

interface Props {
  puntos: Array<{
    id: string;
    data: {
      id: string;
      nombre: string;
      tipo: keyof typeof TIPOS;
      estado: keyof typeof ESTADOS;
      ubicacion: {
        lat: number;
        lng: number;
        descripcion: string;
        comuna: string;
      };
      residuos: Array<keyof typeof RESIDUOS>;
      horario?: string;
      administrador?: string;
      fuente: {
        tipo: keyof typeof TIPOS_DE_FUENTE;
        detalle: string;
        enlace?: string;
      };
      verificacion: {
        fecha: Date;
        delegacion: keyof typeof DELEGACIONES;
      };
      ejemplo: boolean;
    };
  }>;
}

const { puntos } = Astro.props;
---

<section class="seccion-puntos" aria-labelledby="titulo-puntos">
  <div class="puntos-cabecera">
    <h2 id="titulo-puntos">Puntos de reciclaje</h2>
    <p class="puntos-subtitulo">
      Lista equivalente al mapa. Funciona sin conexión interactiva ni descargas externas.
    </p>
  </div>

  {
    puntos.length === 0 ? (
      <p class="puntos-vacio">Aún no hay puntos registrados en el mapa.</p>
    ) : (
      <ul class="puntos-lista" role="list">
        {puntos.map((punto) => {
          const fechaFormateada = fechaComoTexto(punto.data.verificacion.fecha);
          const delegacionNombre =
            DELEGACIONES[punto.data.verificacion.delegacion] || punto.data.verificacion.delegacion;
          const fuenteTipoNombre =
            TIPOS_DE_FUENTE[punto.data.fuente.tipo] || punto.data.fuente.tipo;

          return (
            <li id={`punto-${punto.data.id}`} class="punto-tarjeta">
              <header class="punto-encabezado">
                <div class="punto-titulo-bloque">
                  <span class="punto-tipo">{TIPOS[punto.data.tipo] || punto.data.tipo}</span>
                  <h3 class="punto-nombre">{punto.data.nombre}</h3>
                </div>
                <div class="punto-etiquetas">
                  <span class={`etiqueta estado-${punto.data.estado}`}>
                    {ESTADOS[punto.data.estado] || punto.data.estado}
                  </span>
                  {punto.data.ejemplo && (
                    <span class="etiqueta etiqueta-ejemplo">EJEMPLO</span>
                  )}
                </div>
              </header>

              <div class="punto-cuerpo">
                <p class="punto-ubicacion">
                  <strong>Ubicación:</strong> {punto.data.ubicacion.descripcion} ({punto.data.ubicacion.comuna})
                </p>

                {punto.data.horario && (
                  <p class="punto-horario">
                    <strong>Horario:</strong> {punto.data.horario}
                  </p>
                )}

                <div class="punto-residuos">
                  <strong>Residuos aceptados:</strong>
                  <ul class="residuos-lista">
                    {punto.data.residuos.map((residuo) => (
                      <li>{RESIDUOS[residuo] || residuo}</li>
                    ))}
                  </ul>
                </div>
              </div>

              <footer class="punto-auditoria">
                <p class="auditoria-texto">
                  <small>
                    <strong>Verificado por:</strong> {delegacionNombre} ({fechaFormateada}).<br />
                    <strong>Fuente:</strong> {fuenteTipoNombre} · {punto.data.fuente.detalle}
                    {punto.data.fuente.enlace && (
                      <>
                        {' · '}
                        <a href={punto.data.fuente.enlace} target="_blank" rel="noopener">
                          Ver enlace oficial
                        </a>
                      </>
                    )}
                  </small>
                </p>
              </footer>
            </li>
          );
        })}
      </ul>
    )
  }
</section>

<style>
  .seccion-puntos {
    margin-block: var(--espacio-6);
  }

  .puntos-cabecera {
    margin-bottom: var(--espacio-4);
  }

  .puntos-cabecera h2 {
    margin: 0 0 var(--espacio-1);
    font-size: var(--texto-destacado);
  }

  .puntos-subtitulo {
    margin: 0;
    color: var(--color-tinta-suave);
    font-size: var(--texto-chico);
  }

  .puntos-lista {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--espacio-4);
  }

  .punto-tarjeta {
    background: var(--color-superficie);
    border: var(--borde);
    border-radius: var(--radio);
    padding: var(--espacio-4);
    scroll-margin-top: var(--espacio-5);
  }

  .punto-encabezado {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--espacio-2);
    border-bottom: 1px solid var(--color-linea);
    padding-bottom: var(--espacio-3);
    margin-bottom: var(--espacio-3);
    flex-wrap: wrap;
  }

  .punto-tipo {
    display: block;
    font-size: var(--texto-chico);
    color: var(--color-tinta-suave);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: var(--peso-fuerte);
  }

  .punto-nombre {
    margin: var(--espacio-1) 0 0;
    font-size: var(--texto-destacado);
  }

  .punto-etiquetas {
    display: flex;
    gap: var(--espacio-2);
    align-items: center;
  }

  .etiqueta {
    display: inline-block;
    padding: var(--espacio-1) var(--espacio-3);
    border-radius: var(--radio-pildora);
    font-size: var(--texto-chico);
    font-weight: var(--peso-fuerte);
  }

  .estado-propuesto {
    background: var(--color-propuesto-fondo);
    color: var(--color-propuesto-texto);
    border: 1px solid currentColor;
  }

  .estado-activo {
    background: var(--color-activo-fondo);
    color: var(--color-activo-texto);
    border: 1px solid currentColor;
  }

  .estado-inactivo {
    background: var(--color-inactivo-fondo);
    color: var(--color-inactivo-texto);
    border: 1px solid currentColor;
  }

  .etiqueta-ejemplo {
    background: var(--color-amarillo);
    color: var(--color-tinta);
    border: 1px solid var(--color-tinta);
  }

  .punto-cuerpo {
    font-size: var(--texto-base);
  }

  .punto-ubicacion,
  .punto-horario {
    margin: 0 0 var(--espacio-2);
  }

  .punto-residuos {
    margin-top: var(--espacio-3);
  }

  .residuos-lista {
    margin: var(--espacio-1) 0 0;
    padding-left: var(--espacio-4);
  }

  .residuos-lista li {
    margin-bottom: var(--espacio-1);
  }

  .punto-auditoria {
    margin-top: var(--espacio-4);
    padding-top: var(--espacio-3);
    border-top: 1px solid var(--color-linea);
    color: var(--color-tinta-suave);
  }

  .auditoria-texto {
    margin: 0;
    line-height: 1.45;
  }

  .puntos-vacio {
    padding: var(--espacio-4);
    background: var(--color-superficie);
    border-radius: var(--radio);
    border: var(--borde);
  }
</style>
