---
import '../styles/global.css';

interface Props {
  titulo: string;
  descripcion?: string;
}

const {
  titulo,
  descripcion = 'Mapa de puntos de reciclaje de residuos electrónicos.',
} = Astro.props;
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={descripcion} />
    <!-- Mientras el sitio no se difunda, los buscadores no lo indexan. -->
    <meta name="robots" content="noindex" />
    <title>{titulo} · EcoWaste</title>
  </head>
  <body>
    <main>
      <slot />
    </main>
    <footer>
      <p>
        Proyecto estudiantil del ramo Ecología Integral, Universidad Católica del Norte, sede Coquimbo.
        No es un servicio oficial de la universidad.
      </p>
    </footer>
  </body>
</html>
