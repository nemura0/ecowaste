---
import '../styles/global.css';
import AvisoDemo from '../components/AvisoDemo.astro';
import Cabecera from '../components/Cabecera.astro';
import PiePagina from '../components/PiePagina.astro';

interface Props {
  /** Título de la pestaña del navegador. */
  titulo: string;
  /** Título grande de la página, en la franja verde. Si no se indica, se usa `titulo`. */
  titular?: string;
  descripcion?: string;
}

const {
  titulo,
  titular = titulo,
  descripcion = 'Mapa de puntos de reciclaje de residuos electrónicos.',
} = Astro.props;
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={descripcion} />
    <!-- Mientras el sitio no se difunda, los buscadores no lo indexan. -->
    <meta name="robots" content="noindex" />
    <title>{titulo} · EcoWaste</title>
    <slot name="head" />
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <AvisoDemo />
    <Cabecera titular={titular} />
    <main id="contenido" class="contenedor">
      <slot />
    </main>
    <PiePagina />
  </body>
</html>
